# Copy to .env.local for local builds, and add the same keys in Vercel > Project > Settings > Environment Variables.

# Public site URL (no trailing slash)
SITE_URL=https://sensithrive.com

# Turn on ONLY when you are ready for Google (EHANS permission confirmed, content reviewed).
# false = every page is noindex and robots.txt blocks crawlers.
ALLOW_INDEXING=false

# Where page content comes from at build time: local (data/*.json) or supabase
CONTENT_SOURCE=local

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server-only. Used by the import script and Vercel functions (click log, contact form). Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Search engine verification (or verify by DNS instead, see docs/LAUNCH.md)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# E-E-A-T: the real person who reviews 2026 updates
EDITOR_NAME=
EDITOR_BIO=
CONTACT_EMAIL=hello@sensithrive.com

# When EHANS confirms permission in writing:
# EHANS_PERMISSION_NOTE=Reproduced with permission of EHANS.

# Date shown as "last reviewed" / dateModified
LAST_REVIEWED=2026-10-19

# Product pages not yet re-checked are noindex and left out of the sitemap (protects against "thin content").
# Set true only if you want all ~1,575 product pages indexed immediately.
INDEX_UNVERIFIED_PRODUCTS=false
